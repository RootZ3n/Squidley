# Public Squidley local model configuration.
# These values are read by Next.js API routes on the server side.
# Public Squidley does not use cloud fallback or cloud API keys in this pass.

# Ollama-compatible local endpoint.
SQUIDLEY_LOCAL_ENDPOINT=http://localhost:11434

# Default local chat/build model. Pull it with: ollama pull llama3.2
SQUIDLEY_LOCAL_MODEL=llama3.2

# Public bug report address used for privacy-respecting mailto links.
# Squidley does not upload telemetry or attach local data automatically.
NEXT_PUBLIC_BUG_REPORT_EMAIL=bugs@example.com
