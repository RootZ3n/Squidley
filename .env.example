# Peh local model configuration.
# These values are read by Next.js API routes on the server side.
# Peh does not use cloud fallback or cloud API keys in this pass.
#
# Canonical names are PEH_*. The legacy SQUIDLEY_* names are still honored
# as a fallback during the migration, so existing .env files keep working.

# Ollama-compatible local endpoint.
PEH_LOCAL_ENDPOINT=http://localhost:11434

# Default local chat/build model. Pull it with: ollama pull llama3.2
PEH_LOCAL_MODEL=llama3.2

# Public bug report address used for privacy-respecting mailto links.
# Peh does not upload telemetry or attach local data automatically.
NEXT_PUBLIC_BUG_REPORT_EMAIL=bugs@example.com
